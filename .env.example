# ============================================
# AutoBlog AI — Variáveis de ambiente
# Copie para .env.local (desenvolvimento) e/ou
# configure na Vercel → Settings → Environment Variables
# ============================================

# ---- Senha do painel (OBRIGATÓRIA em produção) ----
# Sem ela, qualquer pessoa com o link acessa o app e gasta suas APIs.
APP_PASSWORD=troque-esta-senha

# ---- Supabase (OBRIGATÓRIO na Vercel — sem persistência sem ele) ----
# Supabase → Project Settings → API → "Project URL" e "service_role" (secret)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ---- Provedores de IA (configure os que for usar) ----
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Qualquer API compatível com OpenAI (OpenRouter, Groq, Together...):
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=openrouter/auto

# ---- Imagens destacadas ----
# Sem chave: usa Pollinations.ai (grátis, sem cadastro).
# Com chave: usa fotos reais do Pexels.
PEXELS_API_KEY=

# ---- Blogger (Google Cloud → Blogger API v3 + OAuth 2.0) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BLOGGER_BLOG_ID=

# ---- WordPress (também pode ser configurado na tela Configurações) ----
WP_SITE_URL=https://seudominio.com.br
WP_USERNAME=seu-usuario
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ---- URL pública do app (callback do OAuth do Google) ----
APP_URL=http://localhost:3000

# ---- Cron de geração automática (opcional) ----
# Vercel → Settings → env CRON_SECRET. Com ele, a Vercel chama
# /api/cron/generate todo dia às 09:00 (ver vercel.json) e o artigo
# fica salvo como RASCUNHO para você revisar.
CRON_SECRET=gere-um-segredo-aleatorio-aqui
